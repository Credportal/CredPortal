@using Analise.Enuns
@model UsuarioModel
@{
    ViewData["Title"] = "Criar usuário";
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">

            <!-- Cartão Principal -->
            <div class="sg-card bg-white p-4 p-md-5 shadow-sm rounded-4 border-0">

                <!-- Cabeçalho -->
                <div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
                    <h5 class="fw-bold text-dark m-0">
                        <i class="fa-solid fa-user-plus text-success me-2"></i>Registar Novo Utilizador
                    </h5>
                    <a class="btn btn-outline-secondary btn-sm rounded-3 px-3" asp-controller="Usuario" asp-action="Index" role="button">
                        <i class="fa-solid fa-arrow-left me-1"></i> Voltar à lista
                    </a>
                </div>

                <form asp-controller="Usuario" asp-action="Criar" method="post" class="needs-validation" novalidate>

                    <!-- Secção: Informações Básicas -->
                    <div class="mb-4">
                        <h6 class="text-success fw-bold mb-3 text-uppercase fs-7" style="letter-spacing: 0.5px;">Informações do Colaborador</h6>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold text-secondary small">Nome do colaborador</label>
                                <input type="text" asp-for="Nome" class="form-control form-control-lg rounded-3 fs-6" placeholder="Digite o nome completo" />
                                <span class="text-danger small">@Html.ValidationMessageFor(x => x.Nome)</span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold text-secondary small">Login</label>
                                <input type="text" asp-for="Login" class="form-control form-control-lg rounded-3 fs-6" placeholder="Nome de utilizador" />
                                <span class="text-danger small">@Html.ValidationMessageFor(x => x.Login)</span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold text-secondary small">E-mail do colaborador</label>
                                <input type="email" asp-for="Email" class="form-control form-control-lg rounded-3 fs-6" placeholder="exemplo@email.com" />
                                <span class="text-danger small">@Html.ValidationMessageFor(x => x.Email)</span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold text-secondary small">Perfil de Acesso</label>
                                <select asp-for="Perfil" class="form-select form-select-lg rounded-3 fs-6">
                                    <option value="">Selecione o perfil</option>
                                    <option value="@PerfilEnum.Admin">Administrador</option>
                                    <option value="@PerfilEnum.Padrao">Padrão</option>
                                </select>
                                <span class="text-danger small">@Html.ValidationMessageFor(x => x.Perfil)</span>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold text-secondary small">Agência</label>
                                <select asp-for="AgenciaId" asp-items="Model.ListaAgencias" class="form-select form-select-lg rounded-3 fs-6">
                                    <option value="">Selecione a agência</option>
                                </select>
                                <span class="text-danger small">@Html.ValidationMessageFor(x => x.AgenciaId)</span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold text-secondary small">Cargo</label>
                                <select asp-for="CargoId" asp-items="Model.ListaCargos" class="form-select form-select-lg rounded-3 fs-6">
                                    <option value="">Selecione o cargo</option>
                                </select>
                                <span class="text-danger small">@Html.ValidationMessageFor(x => x.CargoId)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Campo Senha Oculto (Mantido conforme lógica original) -->
                    <div class="mb-3" style="display: none;">
                        <input type="password" asp-for="Senha" class="form-control" value="1" />
                        @Html.ValidationMessageFor(x => x.Senha)
                    </div>

                    <!-- Secção: Permissões -->
                    <div class="bg-light p-4 rounded-4 mb-4 border">
                        <h6 class="text-success fw-bold mb-3 text-uppercase fs-7" style="letter-spacing: 0.5px;">Permissões do Sistema</h6>

                        <div class="row g-3">
                            <div class="col-12 col-sm-6 col-md-3">
                                <label class="form-label fw-semibold text-secondary small">Criar</label>
                                <select asp-for="Criar" class="form-select rounded-3">
                                    <option value="">Selecione</option>
                                    <option value="Sim">Sim</option>
                                    <option value="Não">Não</option>
                                </select>
                                <span class="text-danger small">@Html.ValidationMessageFor(x => x.Criar)</span>
                            </div>

                            <div class="col-12 col-sm-6 col-md-3">
                                <label class="form-label fw-semibold text-secondary small">Editar</label>
                                <select asp-for="Editar" class="form-select rounded-3">
                                    <option value="">Selecione</option>
                                    <option value="Sim">Sim</option>
                                    <option value="Não">Não</option>
                                </select>
                                <span class="text-danger small">@Html.ValidationMessageFor(x => x.Editar)</span>
                            </div>

                            <div class="col-12 col-sm-6 col-md-3">
                                <label class="form-label fw-semibold text-secondary small">Visualizar</label>
                                <select asp-for="Visualizar" class="form-select rounded-3">
                                    <option value="">Selecione</option>
                                    <option value="Sim">Sim</option>
                                    <option value="Não">Não</option>
                                </select>
                                <span class="text-danger small">@Html.ValidationMessageFor(x => x.Visualizar)</span>
                            </div>

                            <div class="col-12 col-sm-6 col-md-3">
                                <label class="form-label fw-semibold text-secondary small">Administrar</label>
                                <select asp-for="Administrar" class="form-select rounded-3">
                                    <option value="">Selecione</option>
                                    <option value="Sim">Sim</option>
                                    <option value="Não">Não</option>
                                </select>
                                <span class="text-danger small">@Html.ValidationMessageFor(x => x.Administrar)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Botões de Ação -->
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a class="btn btn-outline-secondary px-4 py-2 rounded-3 fw-semibold" asp-controller="Usuario" asp-action="Index" role="button">
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-success px-4 py-2 rounded-3 fw-semibold shadow-sm">
                            <i class="fa-solid fa-check me-1"></i> Adicionar Utilizador
                        </button>
                    </div>

                </form>
            </div>

        </div>
    </div>
</div>