@model List<UsuarioModel>
@{
    ViewData["Title"] = "Usuários";
}

<div class="container-fluid px-0">
    <!-- Feedback de Mensagens -->
    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["MensagemSucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["MensagemErro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["MensagemErro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Cartão Principal -->
    <div class="sg-card bg-white p-4 shadow-sm rounded-4 border-0">

        <!-- Cabeçalho & Ações -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pb-3 mb-4 border-bottom">
            <div>
                <h5 class="fw-bold text-dark m-0">
                    <i class="fa-solid fa-users text-success me-2"></i>Gestão de Utilizadores
                </h5>
                <span class="text-muted small">Consulte, adicione e gere as credenciais e acessos dos colaboradores.</span>
            </div>
            <div>
                <a class="btn btn-success px-4 py-2 rounded-3 fw-semibold shadow-sm" asp-controller="Usuario" asp-action="Criar" role="button">
                    <i class="fa-solid fa-plus me-1"></i> Novo Utilizador
                </a>
            </div>
        </div>

        <!-- Tabela Responsiva -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="table-usuarios" style="font-size: 13px;">
                <thead class="bg-light text-secondary">
                    <tr>
                        <th class="ps-3 border-0" scope="col"># ID</th>
                        <th class="border-0" scope="col">Nome</th>
                        <th class="border-0" scope="col">Login</th>
                        <th class="border-0 text-end pe-3" scope="col">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (UsuarioModel usuario in Model)
                        {
                            <tr class="linha-usuario" data-id="@usuario.Id" style="cursor: pointer;">
                                <td class="ps-3 fw-semibold text-muted">#@usuario.Id</td>
                                <td class="fw-semibold text-dark">
                                    <i class="fa-solid fa-circle-user text-success me-2"></i>@usuario.Nome
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1 font-monospace">@usuario.Login</span>
                                </td>
                                <td class="text-end pe-3">
                                    <a role="button"
                                       class="btn btn-sm btn-outline-secondary rounded-3 px-2 py-1"
                                       asp-route-id="@usuario.Id"
                                       asp-controller="Usuario"
                                       asp-action="Editar"
                                       title="Editar Utilizador">
                                        <i class="fa-solid fa-pen-to-square me-1"></i> Editar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                <i class="fa-regular fa-folder-open fs-3 d-block mb-2 text-secondary"></i>
                                Nenhum utilizador registado no sistema.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal de Contactos -->
<div id="modalContactosUsuario" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-address-book text-success me-2"></i>Lista de Contactos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="listaContactoUsuario"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Inicializa DataTables se disponível
            if ($.fn.DataTable) {
                $('#table-usuarios').DataTable({
                    language: {
                        url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/pt-PT.json'
                    },
                    pageLength: 10,
                    responsive: true
                });
            }

            // Redirecionamento por Duplo Clique na linha
            $('#table-usuarios').on('dblclick', 'tr.linha-usuario', function () {
                var id = $(this).data('id');
                if (id) {
                    window.location.href = '/Usuario/Editar/' + id;
                }
            });
        });
    </script>
}