@model Analise.Models.FechoDiarioViewModel
@{
    ViewData["Title"] = "Mapa de Desempenho e Fecho Diário";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true">

<style>
    body {
        background-color: #f8f9fa;
        font-size: 12px;
    }

    .report-container {
        background: #fff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 0 10px rgba(0,0,0,0.05);
    }

    .table-bordered th, .table-bordered td {
        border: 1px solid #dee2e6 !important;
        vertical-align: middle;
    }

    .table-dark-custom {
        background-color: #343a40 !important;
        color: white !important;
    }

    @@media print {
        .no-print {
            display: none !important;
        }

        body {
            background-color: #fff;
            font-size: 10px;
        }

        .report-container {
            box-shadow: none;
            padding: 0;
        }
    }
</style>

<div class="container-fluid px-4 py-3 report-container">
    <!-- Alertas de Sucesso / Erro -->
    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show no-print" role="alert">
            <i class="fa-solid fa-check-circle me-2"></i> @TempData["MensagemSucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["MensagemErro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show no-print" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["MensagemErro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Cabeçalho de Ações (Não sai na impressão) -->
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <div>
            <h3 class="fw-bold text-dark mb-1">Mapa de Desempenho e Fecho</h3>
            <p class="text-muted small mb-0">Relatório Consolidado de Operações e Carteira</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <form method="get" class="d-flex gap-2 align-items-center mb-0">
                <input type="date" name="data" value="@Model.DataReferencia.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                <button type="submit" class="btn btn-sm btn-secondary">Filtrar</button>
            </form>

            <!-- Botão que aciona o Modal de Confirmação -->
            <button type="button" class="btn btn-sm btn-danger fw-bold" data-bs-toggle="modal" data-bs-target="#modalConfirmarFecho">
                <i class="fa-solid fa-lock me-1"></i> Fechar o Dia
            </button>

            <button onclick="window.print();" class="btn btn-sm btn-success fw-bold" style="background-color: #079b62; border-color: #079b62;">
                <i class="fa-solid fa-print me-1"></i> Imprimir / PDF
            </button>
            <a asp-action="Index" asp-controller="DiaControlo" class="btn btn-sm btn-outline-secondary">Voltar</a>
        </div>
    </div>

    <!-- MODAL DE CONFIRMAÇÃO DE FECHO -->
    <div class="modal fade no-print" id="modalConfirmarFecho" tabindex="-1" aria-labelledby="modalConfirmarFechoLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fs-6" id="modalConfirmarFechoLabel">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i> Confirmação de Fecho Diário
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-start">
                    <p class="mb-2 fw-semibold text-dark">Tem a certeza absoluta de que deseja fechar o dia de hoje?</p>
                    <p class="text-muted small mb-0">
                        Esta acção irá feechar todas  as actividades do dia e não poderá fazer mais actividades hoje.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancelar</button>

                    <form asp-action="FecharDia" method="post" class="mb-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger fw-bold">
                            <i class="fa-solid fa-lock me-1"></i> Sim, Fechar o Dia
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Cabeçalho do Relatório Impresso -->
    <div class="bg-secondary text-white p-2 text-center fw-bold text-uppercase mb-3 rounded-1">
        DESEMPENHO * DIA FECHADO - @Model.DataReferencia.ToString("dd/MM/yyyy")
    </div>

    <div class="d-flex justify-content-between text-muted small mb-3 px-1">
        <span>Período: @Model.DataReferencia.ToString("01/MM/yyyy") - @Model.DataReferencia.ToString("dd/MM/yyyy")</span>
        <span>Gerado em: @DateTime.Now.ToString("HH:mm:ss dd/MM/yyyy") | Operador: Admin</span>
    </div>

    <!-- RESUMO EXECUTIVO DO DIA -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="p-3 border rounded bg-light">
                <span class="text-muted d-block small">Despesas Pagas</span>
                <h5 class="fw-bold text-danger mb-0">MT @Model.TotalDespesasVolume.ToString("N2") <span class="small text-muted">(@Model.TotalDespesasNumero)</span></h5>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-3 border rounded bg-light">
                <span class="text-muted d-block small">Desembolsos Concedidos</span>
                <h5 class="fw-bold text-success mb-0" style="color: #079b62 !important;">MT @Model.TotalDesembolsosVolume.ToString("N2") <span class="small text-muted">(@Model.TotalDesembolsosNumero)</span></h5>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-3 border rounded bg-light">
                <span class="text-muted d-block small">Reembolsos Recebidos</span>
                <h5 class="fw-bold text-primary mb-0">MT @Model.TotalReembolsosVolume.ToString("N2") <span class="small text-muted">(@Model.TotalReembolsosNumero)</span></h5>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-3 border rounded bg-light">
                <span class="text-muted d-block small">Pedidos (Pendentes / Aprovados)</span>
                <h5 class="fw-bold text-dark mb-0">@Model.PedidosPendentesNumero / @Model.PedidosAprovadosNumero</h5>
            </div>
        </div>
    </div>

    <!-- MAPA DE DESEMPENHO -->
    <div class="table-responsive mb-4">
        <table class="table table-bordered table-sm text-end align-middle" style="font-size: 11px;">
            <thead>
                <tr class="table-dark-custom text-center">
                    <th rowspan="2" class="text-start ps-2">CARTEIRA GERAL</th>
                    <th colspan="3">DESEMBOLSO NO MÊS</th>
                    <th colspan="2">VIGENTE</th>
                    <th colspan="2">REEMBOLSO</th>
                    <th colspan="2">CARTEIRA EM MORA HOJE</th>
                    <th colspan="3">CARTEIRA EM MORA TOTAL</th>
                    <th colspan="6">CARTEIRA EM MORA EM DIAS</th>
                </tr>
                <tr class="table-secondary text-center text-dark">
                    <th>Montante</th>
                    <th>#Nov</th>
                    <th>#Rep</th>
                    <th>#</th>
                    <th>Capital</th>
                    <th>Juro</th>
                    <th>Capital</th>
                    <th>#</th>
                    <th>Capital</th>
                    <th>#</th>
                    <th>Capital (Risco)</th>
                    <th>%</th>
                    <th>> 7 Dias</th>
                    <th>#</th>
                    <th>> 15 Dias</th>
                    <th>#</th>
                    <th>> 30 Dias</th>
                    <th>#</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.MapaDesempenho != null && Model.MapaDesempenho.Count > 0)
                {
                    foreach (var item in Model.MapaDesempenho)
                    {
                        <tr>
                            <td class="text-start ps-2 fw-semibold">@item.GestorNome</td>
                            <td>@item.DesembolsoMontante.ToString("N2")</td>
                            <td>@item.QtdNovos</td>
                            <td>@item.QtdRep</td>
                            <td>@item.VigenteQtd</td>
                            <td>@item.VigenteCapital.ToString("N2")</td>
                            <td>N/A</td>
                            <td>@item.ReembolsoCapital.ToString("N2")</td>
                            <td>@item.ReembolsoQtd</td>
                            <td>@item.MoraHojeCapital.ToString("N2")</td>
                            <td>@item.MoraTotalQtd</td>
                            <td>@item.MoraTotalCapital.ToString("N2")</td>
                            <td>@item.MoraTotalPercentual.ToString("N2")%</td>
                            <td>@item.Dias7Capital.ToString("N2")</td>
                            <td>@item.Dias7Qtd</td>
                            <td>@item.Dias15Capital.ToString("N2")</td>
                            <td>@item.Dias15Qtd</td>
                            <td>@item.Dias30Capital.ToString("N2")</td>
                            <td>@item.Dias30Qtd</td>
                        </tr>
                    }
                    <!-- LINHA DE TOTAIS GERAIS -->
                    <tr class="fw-bold table-light text-dark">
                        <td class="text-start ps-2">TOTAL</td>
                        <td>@Model.MapaDesempenho.Sum(x => x.DesembolsoMontante).ToString("N2")</td>
                        <td>@Model.MapaDesempenho.Sum(x => x.QtdNovos)</td>
                        <td>@Model.MapaDesempenho.Sum(x => x.QtdRep)</td>
                        <td>@Model.MapaDesempenho.Sum(x => x.VigenteQtd)</td>
                        <td>@Model.MapaDesempenho.Sum(x => x.VigenteCapital).ToString("N2")</td>
                        <td>N/A</td>
                        <td>@Model.MapaDesempenho.Sum(x => x.ReembolsoCapital).ToString("N2")</td>
                        <td>@Model.MapaDesempenho.Sum(x => x.ReembolsoQtd)</td>
                        <td>@Model.MapaDesempenho.Sum(x => x.MoraHojeCapital).ToString("N2")</td>
                        <td>@Model.MapaDesempenho.Sum(x => x.MoraTotalQtd)</td>
                        <td>@Model.MapaDesempenho.Sum(x => x.MoraTotalCapital).ToString("N2")</td>
                        <td>-</td>
                        <td>@Model.MapaDesempenho.Sum(x => x.Dias7Capital).ToString("N2")</td>
                        <td>@Model.MapaDesempenho.Sum(x => x.Dias7Qtd)</td>
                        <td>@Model.MapaDesempenho.Sum(x => x.Dias15Capital).ToString("N2")</td>
                        <td>@Model.MapaDesempenho.Sum(x => x.Dias15Qtd)</td>
                        <td>@Model.MapaDesempenho.Sum(x => x.Dias30Capital).ToString("N2")</td>
                        <td>@Model.MapaDesempenho.Sum(x => x.Dias30Qtd)</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="19" class="text-center py-3 text-muted">Nenhum dado de desempenho registado para a data selecionada.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- SALDOS DE CONTAS E BANCÁRIOS (COM ABERTURA, CRÉDITOS, DÉBITOS E FECHO) -->
    <div class="row mt-4">
        <div class="col-12">
            <h5 class="fw-bold text-dark mb-2"><i class="fa-solid fa-wallet me-2"></i>Saldos e Movimentos por Conta / Caixa</h5>
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle text-end">
                    <thead class="table-light text-center">
                        <tr>
                            <th class="text-start ps-2">Banco / Conta</th>
                            <th class="text-start">Titular</th>
                            <th>Saldo de Abertura (MT)</th>
                            <th>Créditos (+) (MT)</th>
                            <th>Débitos (-) (MT)</th>
                            <th>Saldo de Fecho (MT)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.SaldosContas != null && Model.SaldosContas.Count > 0)
                        {
                            foreach (var c in Model.SaldosContas)
                            {
                                <tr>
                                    <td class="text-start ps-2 fw-semibold">@c.Banco - @c.Conta</td>
                                    <td class="text-start">@c.Titular</td>
                                    <td>@c.SaldoAbertura.ToString("N2")</td>
                                    <td class="text-success fw-semibold">+ @c.Creditos.ToString("N2")</td>
                                    <td class="text-danger fw-semibold">- @c.Debitos.ToString("N2")</td>
                                    <td class="fw-bold text-dark">@c.SaldoFecho.ToString("N2")</td>
                                </tr>
                            }
                            <!-- LINHA DE TOTAIS GERAIS DAS CONTAS -->
                            <tr class="fw-bold table-light text-dark">
                                <td colspan="2" class="text-start ps-2">TOTAL GERAL</td>
                                <td>@Model.SaldosContas.Sum(x => x.SaldoAbertura).ToString("N2")</td>
                                <td class="text-success">+ @Model.SaldosContas.Sum(x => x.Creditos).ToString("N2")</td>
                                <td class="text-danger">- @Model.SaldosContas.Sum(x => x.Debitos).ToString("N2")</td>
                                <td>@Model.SaldosContas.Sum(x => x.SaldoFecho).ToString("N2")</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-3 text-muted">Nenhuma conta registada.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>