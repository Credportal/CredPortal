@model Analise.Models.PedidoModel
@{
    ViewData["Title"] = "Documentos do Pedido";

    // Cálculo dinâmico do custo administrativo com base na regra de negócio
    decimal valorEmprestimo = Model.ValorDesembolsado > 0 ? Model.ValorDesembolsado : (Model.ValorDecisao ?? Model.Valor);
    decimal custoAdministrativo = valorEmprestimo <= 10000 ? 200m : (valorEmprestimo * 0.02m);
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true">

<div class="container-fluid px-4 py-3">
    <!-- Cabeçalho da Página -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Documentos do Pedido #@Model.Id</h2>
            <p class="text-muted small mb-0">Gestão de Contrato, Garantias, Intervenientes e Plano de Amortização</p>
        </div>
        <a asp-controller="Pedido" asp-action="Ver" class="btn btn-outline-secondary rounded-2 px-3 d-flex align-items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i> Voltar à Lista de Pedidos
        </a>
    </div>

    <!-- Informações do Cliente, CRR e Botões de PDF Compactos -->
    <div class="card shadow-sm border-0 rounded-4 bg-white mb-4">
        <div class="card-body p-4">
            <div class="row g-3 align-items-center">
                <div class="col-md-7">
                    <span class="d-block text-secondary small text-uppercase fw-semibold">Mutuário (Cliente)</span>
                    <div class="d-flex flex-wrap align-items-center gap-3 mt-1">
                        <h5 class="fw-bold text-dark mb-0">@Model.Entidade?.Nome <span class="text-muted small">(ID: #@Model.Id)</span></h5>

                        <!-- Botões Pequenos de Geração de Documentos -->
                        <div class="d-flex align-items-center gap-2">
                            <a asp-controller="Pedido" asp-action="GerarContratoPdf" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-success rounded-2 fw-semibold px-2 py-1 shadow-sm d-flex align-items-center gap-1" style="color: #079b62; border-color: #079b62;" title="Gerar Contrato (PDF)">
                                <i class="fa-solid fa-file-contract"></i> Contrato
                            </a>
                        </div>
                    </div>
                    <!-- Detalhes extra do Cliente -->
                    <div class="text-muted small mt-2">
                        Naturalidade: <strong>@(Model.Entidade?.Naturalidade ?? "-")</strong> |
                        Residente: <strong>@(Model.Entidade?.Endereco ?? "-")</strong> |
                        Doc: <strong>@(Model.Entidade?.Documento ?? "BI") N° @(Model.Entidade?.NrDocumento ?? "-")</strong>
                        (Emitido em: @(Model.Entidade?.Emissao?.ToString("dd-MM-yyyy") ?? "-") | Válido até: @(Model.Entidade?.Validade?.ToString("dd-MM-yyyy") ?? "-")) |
                        NUIT: <code>@(Model.Entidade?.Nuit ?? "-")</code>
                    </div>
                </div>

                <div class="col-md-5 text-md-end">
                    <span class="d-block text-secondary small text-uppercase fw-semibold">Código CRR</span>
                    <h5 class="font-monospace fw-bold text-success mb-0" style="color: #079b62 !important;">@(Model.CRR.HasValue ? Model.CRR.Value.ToString("0") : "Não atribuído")</h5>
                </div>
            </div>

            <hr class="my-4 text-muted" />

            <div class="row g-4">
                <div class="col-md-3 border-end">
                    <span class="d-block text-secondary small text-uppercase fw-semibold">Valor do Empréstimo</span>
                    <h4 class="fw-bold text-success mb-0 mt-1" style="color: #079b62 !important;">MT @valorEmprestimo.ToString("N2")</h4>
                </div>
                <div class="col-md-3 border-end">
                    <span class="d-block text-secondary small text-uppercase fw-semibold">Prazo</span>
                    <h4 class="fw-bold text-dark mb-0 mt-1">@(Model.PrazoDecisao ?? Model.Prazo) Meses</h4>
                </div>
                <div class="col-md-3 border-end">
                    <span class="d-block text-secondary small text-uppercase fw-semibold">Taxa de Juro</span>
                    <h4 class="fw-bold text-dark mb-0 mt-1">@((Model.TaxaDecisao ?? Model.Taxa).ToString("N2"))%</h4>
                </div>
                <div class="col-md-3">
                    <span class="d-block text-secondary small text-uppercase fw-semibold">Prestação</span>
                    <h4 class="fw-bold text-dark mb-0 mt-1">MT @((Model.PrestacaoDecisao ?? Model.Prestacao).ToString("N2"))</h4>
                </div>
            </div>

            <!-- Informação dos Custos Administrativos Aplicados -->
            <div class="mt-4 p-3 bg-light rounded-3 border d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-secondary small fw-semibold text-uppercase d-block">Comissão / Custos Administrativos</span>
                    <span class="text-muted small">Regra aplicada: 200 MT (até 10.000 MT) ou 2% (acima de 10.000 MT)</span>
                </div>
                <h5 class="fw-bold text-dark mb-0">MT @custoAdministrativo.ToString("N2")</h5>
            </div>
        </div>
    </div>

    <!-- Garantias do Cliente Principal -->
    <div class="card shadow-sm border-0 rounded-4 bg-white p-4 mb-4">
        <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-user-shield text-success me-2" style="color: #079b62 !important;"></i>Garantias do Mutuário</h5>
        <div class="table-responsive bg-white rounded-2 border p-2">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light text-muted small">
                    <tr>
                        <th>DESCRIÇÃO</th>
                        <th class="text-end">VALOR (MT)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.GarantiasCliente != null && ((List<Analise.Models.GarantiaModel>)ViewBag.GarantiasCliente).Any())
                    {
                        @foreach (var g in (List<Analise.Models.GarantiaModel>)ViewBag.GarantiasCliente)
                        {
                            <tr>
                                <td>@g.Descricao</td>
                                <td class="fw-semibold text-success text-end" style="color: #079b62 !important;">@g.ValorActual.ToString("N2")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-center py-2 text-muted small">Nenhuma garantia registada para o mutuário.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Lista de Intervenientes e Garantias -->
    <div class="card shadow-sm border-0 rounded-4 bg-white p-4 mb-4">
        <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-users text-success me-2" style="color: #079b62 !important;"></i>Co-Mutuários e Avalistas</h5>

        @if (ViewBag.Intervenientes != null && ((List<Analise.Models.IntervenienteModel>)ViewBag.Intervenientes).Any())
        {
            var garantiasMap = ViewBag.GarantiasPorInterveniente as Dictionary<int, List<Analise.Models.GarantiaModel>>;

            @foreach (var inter in (List<Analise.Models.IntervenienteModel>)ViewBag.Intervenientes)
            {
                var ent = inter.IntervenienteEntidade;
                var garantiasDoInterveniente = garantiasMap != null && garantiasMap.ContainsKey(inter.IntervenienteID)
                    ? garantiasMap[inter.IntervenienteID]
                    : new List<Analise.Models.GarantiaModel>();

                <div class="card border rounded-3 p-3 mb-3 bg-light">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <h6 class="fw-bold text-dark mb-0">@(ent != null ? ent.Nome : "Interveniente #" + inter.IntervenienteID) <span class="badge bg-secondary">@inter.Tipo</span></h6>
                            <span class="text-muted small">
                                Naturalidade: <strong>@(ent?.Naturalidade ?? "-")</strong> | Residente: <strong>@(ent?.Endereco ?? "-")</strong> |
                                Doc: <strong>@(ent?.Documento ?? "BI") N° @(ent?.NrDocumento ?? "-")</strong>
                                (Emitido em: @(ent?.Emissao?.ToString("dd-MM-yyyy") ?? "-") | Válido até: @(ent?.Validade?.ToString("dd-MM-yyyy") ?? "-"))
                            </span>
                        </div>
                    </div>

                    <div class="table-responsive bg-white rounded-2 border p-2 mt-2">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light text-muted small">
                                <tr>
                                    <th>DESCRIÇÃO DOS BENS DO @inter.Tipo.ToUpper()</th>
                                    <th class="text-end">VALOR (MT)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (garantiasDoInterveniente.Any())
                                {
                                    @foreach (var g in garantiasDoInterveniente)
                                    {
                                        <tr>
                                            <td>@g.Descricao</td>
                                            <td class="fw-semibold text-success text-end" style="color: #079b62 !important;">@g.ValorActual.ToString("N2")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="2" class="text-center py-2 text-muted small">Nenhuma garantia registada para este interveniente.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted text-center py-3 mb-0">Nenhum interveniente associado a este pedido.</p>
        }
    </div>

    <!-- PLANO DE AMORTIZAÇÃO (Carregado da Tabela Amortizacoes) -->
    <div class="card shadow-sm border-0 rounded-4 bg-white p-4 mb-4">
        <h5 class="fw-bold text-dark mb-3">
            <i class="fa-solid fa-table-list text-success me-2" style="color: #079b62 !important;"></i>
            Plano de Amortização do Crédito
        </h5>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0 border rounded-3 overflow-hidden">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-3 py-2">Nr</th>
                        <th class="py-2">Data de Vencimento</th>
                        <th class="py-2 text-end">Prestação (MT)</th>
                        <th class="py-2 text-end">Juro (MT)</th>
                        <th class="py-2 text-end">Amortização (MT)</th>
                        <th class="py-2 text-end">Capital em Dívida (MT)</th>
                        <th class="py-2 text-end">Valor Pago (MT)</th>
                        <th class="py-2 text-end pe-3">Valor a Pagar (MT)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.ListaAmortizacoes != null && ((List<Analise.Models.AmortizacaoModel>)ViewBag.ListaAmortizacoes).Any())
                    {
                        foreach (var item in (List<Analise.Models.AmortizacaoModel>)ViewBag.ListaAmortizacoes)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold text-dark">@item.NR</td>
                                <td><span class="badge bg-light text-dark border px-2 py-1"><i class="fa-regular fa-calendar me-1 text-muted"></i> @item.Vencimento.ToString("dd/MM/yyyy")</span></td>
                                <td class="text-end fw-bold">MT @item.Prestacao.ToString("N2")</td>
                                <td class="text-end text-danger">MT @item.Juro.ToString("N2")</td>
                                <td class="text-end text-success">MT @item.Principal.ToString("N2")</td>
                                <td class="text-end fw-semibold text-secondary">MT @item.PrincipalPorPagar.ToString("N2")</td>
                                <td class="text-end fw-bold text-primary">MT @item.TotalPago.ToString("N2")</td>
                                <td class="text-end pe-3 fw-bold text-warning">MT @item.TotalPorPagar.ToString("N2")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted small">Nenhum plano de amortização registado para este pedido.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>