@model Analise.Models.PedidoModel
@{
    ViewData["Title"] = "Detalhes do Pedido";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true">

<div class="container-fluid px-4 py-3">
    <!-- Cabeçalho da Página -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Detalhes do Pedido #@Model.Id</h2>
            <p class="text-muted small mb-0">Informações completas relativas ao pedido de crédito selecionado.</p>
        </div>
        <div>
            <a asp-action="Ver" class="btn btn-outline-secondary rounded-2 px-3 d-flex align-items-center gap-2">
                <i class="fa-solid fa-arrow-left"></i> Voltar à Lista
            </a>
        </div>
    </div>

    <!-- Cartão de Visualização -->
    <div class="card shadow-sm border-0 rounded-4 bg-white">
        <div class="card-body p-4">
            <div class="row g-3">
                <!-- Entidade / Cliente -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary">Entidade / Cliente</label>
                    <input type="text" class="form-control rounded-2 shadow-sm bg-light fw-medium" readonly value="@(Model.Entidade != null ? Model.Entidade.Nome : "Entidade #" + Model.EntidadeId)" />
                </div>

                <!-- Código CRR -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary">Código CRR</label>
                    <input type="text" class="form-control rounded-2 shadow-sm bg-light fw-bold text-success font-monospace" readonly value="@(Model.CRR.HasValue ? Model.CRR.Value.ToString("0") : "Não atribuído")" />
                </div>

                <!-- Gestor Responsável -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary">Gestor Responsável</label>
                    <input type="text" class="form-control rounded-2 shadow-sm bg-light" readonly value="@(Model.Gestor != null ? Model.Gestor.Login : (Model.GestorId.HasValue ? "Utilizador #" + Model.GestorId : "Não atribuído"))" />
                </div>

                <!-- Estado do Pedido -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary">Estado Atual</label>
                    <div class="form-control rounded-2 shadow-sm bg-light">
                        @switch (Model.EstadoId)
                        {
                            case 1:
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2 py-1">Pendente</span>
                                break;
                            case 2:
                                <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2 py-1">Aprovado</span>
                                break;
                            case 3:
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">Vigente</span>
                                break;
                            case 4:
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">Liquidado</span>
                                break;
                            default:
                                <span class="badge bg-light text-dark border rounded-pill px-2 py-1">Desconhecido</span>
                                break;
                        }
                    </div>
                </div>

                <!-- Valor do Empréstimo -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary">Valor do Empréstimo (MT)</label>
                    <input type="text" class="form-control rounded-2 shadow-sm bg-light fw-bold" readonly value="MT @Model.Valor.ToString("N2")" />
                </div>

                <!-- Prazo em Meses -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary">Prazo (Meses)</label>
                    <input type="text" class="form-control rounded-2 shadow-sm bg-light" readonly value="@Model.Prazo meses" />
                </div>

                <!-- Taxa de Juro (%) -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary">Taxa de Juro (%)</label>
                    <input type="text" class="form-control rounded-2 shadow-sm bg-light" readonly value="@Model.Taxa.ToString("N2") %" />
                </div>

                <!-- Prestação Mensal -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary">Prestação Mensal (MT)</label>
                    <input type="text" class="form-control rounded-2 shadow-sm bg-light fw-semibold text-dark" readonly value="MT @Model.Prestacao.ToString("N2")" />
                </div>

                <!-- Data de Cadastro -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary">Data de Cadastro</label>
                    <input type="text" class="form-control rounded-2 shadow-sm bg-light" readonly value="@Model.DataCadastro.ToString("dd/MM/yyyy HH:mm")" />
                </div>

                <!-- Destino do Crédito -->
                <div class="col-md-12">
                    <label class="form-label fw-semibold text-secondary">Destino do Crédito</label>
                    <textarea class="form-control rounded-2 shadow-sm bg-light" rows="3" readonly>@Model.Destino</textarea>
                </div>
            </div>

            <!-- Rodapé com Ações (Atualizado) -->
            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-action="Ver" class="btn btn-light px-4 rounded-2 text-secondary border">Voltar</a>

                <!-- NOVO BOTÃO: Gerar Formulário PDF -->
                <a asp-action="GerarFormularioPedidoPdf" asp-route-id="@Model.Id" class="btn btn-success px-4 rounded-2 text-white fw-normal" style="background-color: #079b62; border-color: #079b62;">
                    <i class="fa-solid fa-file-pdf me-1"></i> Ficha PDF
                </a>
            </div>
        </div>
    </div>
</div>