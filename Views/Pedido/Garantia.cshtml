@model GarantiaViewModel
@{
    ViewData["Title"] = "Gerir Garantias";

    // Cálculos de totais
    int totalItens = Model.ListaGarantias != null ? Model.ListaGarantias.Count : 0;
    decimal somaAquisicao = Model.ListaGarantias != null ? Model.ListaGarantias.Sum(g => g.ValorAquisicao) : 0;
    decimal somaActual = Model.ListaGarantias != null ? Model.ListaGarantias.Sum(g => g.ValorActual) : 0;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true">

<div class="container-fluid px-4 py-3">
    <!-- Alertas -->
    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["MensagemSucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["MensagemErro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["MensagemErro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Cabeçalho da Página -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Gestão de Garantias e Colaterais</h2>
            <p class="text-muted small mb-0">Associadas ao Pedido #@Model.PedidoId</p>
        </div>
        <a asp-controller="Pedido" asp-action="Ver" class="btn btn-outline-secondary rounded-2 px-3 d-flex align-items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i> Voltar à Lista de Pedidos
        </a>
    </div>

    <!-- Informações do Cliente & CRR -->
    <div class="card shadow-sm border-0 rounded-4 bg-white mb-4">
        <div class="card-body p-4">
            <div class="row g-3 align-items-center">
                <div class="col-md-6">
                    <span class="d-block text-secondary small text-uppercase fw-semibold">Entidade / Cliente</span>
                    <h5 class="fw-bold text-dark mb-0">@Model.NomeEntidade <span class="text-muted small">(ID: #@Model.EntidadeId)</span></h5>
                </div>
                <div class="col-md-6 text-md-end">
                    <span class="d-block text-secondary small text-uppercase fw-semibold">Código CRR</span>
                    <h5 class="font-monospace fw-bold text-success mb-0" style="color: #079b62 !important;">@(Model.Crr.HasValue ? Model.Crr.Value.ToString("0") : "Não atribuído")</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- Formulário para Registar Nova Garantia -->
    <div class="card shadow-sm border-0 rounded-4 bg-white mb-4">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <h5 class="fw-bold text-dark mb-0"><i class="fa-solid fa-shield-halved text-success me-2" style="color: #079b62 !important;"></i> Registar Nova Garantia</h5>
        </div>
        <div class="card-body p-4">
            <form asp-controller="Pedido" asp-action="CriarGarantia" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="pedidoId" value="@Model.PedidoId" />
                <input type="hidden" asp-for="NovaGarantia.EntidadeId" value="@Model.EntidadeId" />
                <input type="hidden" asp-for="NovaGarantia.Crr" value="@Model.Crr" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="NovaGarantia.Tipo" class="form-label fw-semibold text-secondary">Tipo de Garantia</label>
                        <select asp-for="NovaGarantia.Tipo" class="form-select rounded-2 shadow-sm">
                            <option value="">-- Selecione o Tipo --</option>
                            <option value="Penhor">Penhor</option>
                            <option value="Hipoteca">Hipoteca</option>
                            <option value="Outras">Outras</option>
                        </select>
                        <span asp-validation-for="NovaGarantia.Tipo" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="NovaGarantia.ValorAquisicao" class="form-label fw-semibold text-secondary">Valor de Aquisição (MT)</label>
                        <input asp-for="NovaGarantia.ValorAquisicao" class="form-control rounded-2 shadow-sm" type="number" step="0.01" placeholder="0.00" />
                        <span asp-validation-for="NovaGarantia.ValorAquisicao" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="NovaGarantia.ValorActual" class="form-label fw-semibold text-secondary">Valor Atual (MT)</label>
                        <input asp-for="NovaGarantia.ValorActual" class="form-control rounded-2 shadow-sm" type="number" step="0.01" placeholder="0.00" />
                        <span asp-validation-for="NovaGarantia.ValorActual" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="NovaGarantia.Descricao" class="form-label fw-semibold text-secondary">Descrição</label>
                        <textarea asp-for="NovaGarantia.Descricao" class="form-control rounded-2 shadow-sm" rows="2" placeholder="Descreva detalhadamente a garantia..."></textarea>
                        <span asp-validation-for="NovaGarantia.Descricao" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-success px-4 rounded-2 text-white fw-normal" style="background-color: #079b62; border-color: #079b62;">
                        <i class="fa-solid fa-plus me-1"></i> Adicionar Garantia
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Cards de Resumo (Total de Itens e Somatórios) -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
                <span class="text-muted small text-uppercase fw-semibold">Total de Itens</span>
                <h4 class="fw-bold text-dark mb-0 mt-1"><i class="fa-solid fa-list-check text-success me-2" style="color: #079b62 !important;"></i> @totalItens</h4>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
                <span class="text-muted small text-uppercase fw-semibold">Total Aquisição</span>
                <h4 class="fw-bold text-dark mb-0 mt-1">MT @somaAquisicao.ToString("N2")</h4>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
                <span class="text-muted small text-uppercase fw-semibold">Total Atual</span>
                <h4 class="fw-bold text-success mb-0 mt-1" style="color: #079b62 !important;">MT @somaActual.ToString("N2")</h4>
            </div>
        </div>
    </div>

    <!-- Tabela com a Lista de Garantias Associadas -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <h5 class="fw-bold text-dark mb-0">Garantias Associadas</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4 py-3">ID</th>
                        <th class="py-3">Tipo</th>
                        <th class="py-3">Descrição</th>
                        <th class="py-3">Valor Aquisição (MT)</th>
                        <th class="py-3">Valor Atual (MT)</th>
                        <th class="py-3">Data Registo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ListaGarantias != null && Model.ListaGarantias.Any())
                    {
                        @foreach (var g in Model.ListaGarantias)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">#@g.Id</td>
                                <td>
                                    <span class="badge bg-light text-dark border rounded-pill px-2 py-1">@g.Tipo</span>
                                </td>
                                <td class="fw-medium text-dark">@g.Descricao</td>
                                <td class="fw-bold">MT @g.ValorAquisicao.ToString("N2")</td>
                                <td class="fw-semibold text-success" style="color: #079b62 !important;">MT @g.ValorActual.ToString("N2")</td>
                                <td>@g.DataCadastro.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Nenhuma garantia registada para este cliente/CRR.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}