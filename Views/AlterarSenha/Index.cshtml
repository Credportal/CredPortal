@model AlterarSenhaModel
@{
    ViewData["Title"] = "Alterar senha";
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-8">

            <!-- Mensagens de Sucesso / Erro -->
            @if (TempData["MensagemSucesso"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i>@TempData["MensagemSucesso"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["MensagemErro"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["MensagemErro"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Cartão Principal -->
            <div class="sg-card bg-white p-4 p-md-5 shadow-sm rounded-4 border-0">

                <!-- Cabeçalho -->
                <div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
                    <h5 class="fw-bold text-dark m-0">
                        <i class="fa-solid fa-key text-success me-2"></i>Alterar a Minha Senha
                    </h5>
                    <a class="btn btn-outline-secondary btn-sm rounded-3 px-3" asp-controller="Home" asp-action="Index" role="button">
                        <i class="fa-solid fa-arrow-left me-1"></i> Voltar
                    </a>
                </div>

                <form asp-controller="AlterarSenha" asp-action="Alterar" method="post" class="needs-validation" novalidate>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Senha actual</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 rounded-start-3 text-muted"><i class="fa-solid fa-lock"></i></span>
                            <input type="password" id="SenhaActual" asp-for="SenhaActual" class="form-control form-control-lg border-start-0 rounded-end-3 fs-6" placeholder="Digite a senha actual" />
                        </div>
                        <span class="text-danger small">@Html.ValidationMessageFor(x => x.SenhaActual)</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Nova senha</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 rounded-start-3 text-muted"><i class="fa-solid fa-key"></i></span>
                            <input type="password" id="NovaSenha" asp-for="NovaSenha" class="form-control form-control-lg border-start-0 rounded-end-3 fs-6" placeholder="Digite a nova senha" />
                        </div>
                        <span class="text-danger small">@Html.ValidationMessageFor(x => x.NovaSenha)</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Confirmar nova senha</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 rounded-start-3 text-muted"><i class="fa-solid fa-check-double"></i></span>
                            <input type="password" id="ConfirmarNovaSenha" asp-for="ConfirmarNovaSenha" class="form-control form-control-lg border-start-0 rounded-end-3 fs-6" placeholder="Confirme a nova senha" />
                        </div>
                        <span class="text-danger small">@Html.ValidationMessageFor(x => x.ConfirmarNovaSenha)</span>
                    </div>

                    <div class="mb-4 form-check">
                        <input type="checkbox" class="form-check-input" id="MostrarSenha" />
                        <label class="form-check-label text-secondary small user-select-none" for="MostrarSenha">Mostrar senha</label>
                    </div>

                    <!-- Botões de Ação -->
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a class="btn btn-outline-secondary px-4 py-2 rounded-3 fw-semibold" asp-controller="Home" asp-action="Index" role="button">
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-success px-4 py-2 rounded-3 fw-semibold shadow-sm">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Salvar Alteração
                        </button>
                    </div>

                </form>
            </div>

        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
    document.getElementById('MostrarSenha').addEventListener('change', function () {
        const type = this.checked ? 'text' : 'password';
        document.getElementById('SenhaActual').type = type;
        document.getElementById('NovaSenha').type = type;
        document.getElementById('ConfirmarNovaSenha').type = type;
    });
</script>