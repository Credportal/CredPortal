@model LoginModel
@{
    Layout = "_Layout_Deslogado";
    ViewData["Title"] = "Redefinir Senha";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

<div class="container py-5">
    <div class="row justify-content-center align-items-center min-vh-75">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">

            <!-- Alerta de Sucesso com Destaque para a Senha -->
            @if (TempData["MensagemSucesso"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4 p-4 text-center" role="alert">
                    <i class="fa-solid fa-circle-check fs-2 text-success mb-2 d-block"></i>
                    <h5 class="fw-bold text-success">Senha Redefinida!</h5>
                    <p class="mb-2 text-dark">@TempData["MensagemSucesso"]</p>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["MensagemErro"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["MensagemErro"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Cartão Principal -->
            <div class="sg-card bg-white p-4 p-md-5 shadow-sm rounded-4 border-0">

                <div class="text-center mb-4">
                    <div class="bg-success-subtle text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 55px; height: 55px;">
                        <i class="fa-solid fa-key fs-4"></i>
                    </div>
                    <h3 class="fw-bold text-dark">Redefinir Senha</h3>
                    <p class="text-muted small">Insira o login para verificar o utilizador e gerar uma nova senha imediata.</p>
                </div>

                <form asp-controller="Login" asp-action="EnviarLinkParaRedefinirSenha" method="post">

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Login de Utilizador</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 rounded-start-3 text-muted"><i class="fa-solid fa-user"></i></span>
                            <input type="text" asp-for="Login" class="form-control form-control-lg border-start-0 rounded-end-3 fs-6" placeholder="Digite o seu login" id="Login" />
                        </div>
                        <span class="text-danger small">@Html.ValidationMessageFor(x => x.Login)</span>
                    </div>

                    <div class="mb-3" style="display: none;">
                        <input type="text" asp-for="Email" class="form-control" id="Email" readonly />
                    </div>

                    <div class="mb-3 text-center">
                        <div id="mensagemUsuario" class="small" style="font-weight: 600;"></div>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <button type="button" class="btn btn-outline-secondary py-2 rounded-3 fw-semibold" id="btnVerificar">
                            <i class="fa-solid fa-magnifying-glass me-1"></i> Verificar Utilizador
                        </button>

                        <button type="submit" class="btn btn-success py-2 rounded-3 fw-semibold shadow-sm" id="btnRedefinir" disabled>
                            <i class="fa-solid fa-rotate-right me-1"></i> Gerar e Exibir Nova Senha
                        </button>
                    </div>

                    <div class="text-center pt-3 border-top">
                        <a class="text-decoration-none text-muted small fw-semibold" asp-controller="Login" asp-action="Index">
                            <i class="fa-solid fa-arrow-left me-1"></i> Voltar à página de login
                        </a>
                    </div>

                </form>
            </div>

        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $("#btnVerificar").on("click", function (e) {
            e.preventDefault();

            var login = $("#Login").val().trim();
            if (login.length === 0) {
                alert("Por favor, insira um login.");
                return;
            }

            $("#mensagemUsuario").text("A verificar...").css("color", "#6c757d");

            $.get("/Login/ObterEmailPorLogin", { login: login }, function (res) {
                if (res.sucesso) {
                    $("#Email").val(res.email);
                    $("#mensagemUsuario").html('<i class="fa-solid fa-circle-check text-success me-1"></i> Utilizador verificado com sucesso').css("color", "#198754");
                    $("#btnRedefinir").prop("disabled", false);
                } else {
                    $("#Email").val("");
                    $("#mensagemUsuario").html('<i class="fa-solid fa-circle-xmark text-danger me-1"></i> Utilizador não encontrado').css("color", "#dc3545");
                    $("#btnRedefinir").prop("disabled", true);
                }
            });
        });
    });
</script>