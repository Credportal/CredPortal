@model Analise.Models.ContaModel
@{
    ViewData["Title"] = "Registar Nova Conta Bancária";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true">

<div class="text-center">
    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success" role="alert">
            <button type="button" class="btn btn-danger btn-sm close-alert" aria-label="Close">X</button>
            @TempData["MensagemSucesso"]
        </div>
    }

    @if (TempData["MensagemErro"] != null)
    {
        <div class="alert alert-danger" role="alert">
            <button type="button" class="btn btn-danger btn-sm close-alert" aria-label="Close">X</button>
            @TempData["MensagemErro"]
        </div>
    }
</div>

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Registar Nova Conta Bancária</h2>
            <p class="text-muted small mb-0">Preencha os dados abaixo para adicionar uma nova conta institucional ao sistema.</p>
        </div>
        <a asp-action="Ver" class="btn btn-outline-secondary rounded-2 px-3 d-flex align-items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i> Voltar à Lista
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 bg-white">
        <div class="card-body p-4">
            <form asp-action="Criar" method="post" id="formCriarConta">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <!-- Banco -->
                    <div class="col-md-6">
                        <label asp-for="Banco" class="form-label fw-semibold text-secondary">Banco</label>
                        <input asp-for="Banco" class="form-control rounded-2 shadow-sm" placeholder="Ex: Standard Bank, BCI, Moza..." />
                        <span asp-validation-for="Banco" class="text-danger small"></span>
                    </div>

                    <!-- Número da Conta -->
                    <div class="col-md-6">
                        <label asp-for="Conta" class="form-label fw-semibold text-secondary">Número da Conta</label>
                        <input asp-for="Conta" class="form-control rounded-2 shadow-sm" placeholder="Ex: 3322020000" />
                        <span asp-validation-for="Conta" class="text-danger small"></span>
                    </div>

                    <!-- NIB -->
                    <div class="col-md-6">
                        <label asp-for="NIB" class="form-label fw-semibold text-secondary">NIB</label>
                        <input asp-for="NIB" class="form-control rounded-2 shadow-sm" placeholder="Ex: 0120 0000 0000 0000" />
                        <span asp-validation-for="NIB" class="text-danger small"></span>
                    </div>

                    <!-- Titular -->
                    <div class="col-md-6">
                        <label asp-for="Titular" class="form-label fw-semibold text-secondary">Titular da Conta</label>
                        <input asp-for="Titular" class="form-control rounded-2 shadow-sm" placeholder="Ex: Nael Microcrédito E.I." />
                        <span asp-validation-for="Titular" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Ver" class="btn btn-light px-4 rounded-2 text-secondary border">Cancelar</a>
                    <button type="submit" class="btn btn-success px-4 rounded-2 text-white fw-normal" style="background-color: #079b62; border-color: #079b62;">
                        <i class="fa-solid fa-check me-1"></i> Registar Conta
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}