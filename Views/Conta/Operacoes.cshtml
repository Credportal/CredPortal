@model Analise.Models.OperacoesViewModel
@{
    ViewData["Title"] = "Operações Bancárias";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true">

<div class="container-fluid px-4 py-3">
    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Operações Bancárias</h2>
            <p class="text-muted small mb-0">Gestão das operações bancárias em Moçambique.</p>
        </div>
        <div>
            <span class="badge bg-light text-secondary border px-3 py-2 fw-semibold">
                <i class="fa-solid fa-location-dot text-success me-1"></i> Agência Maputo
            </span>
        </div>
    </div>

    <!-- Alertas -->
    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["MensagemSucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["MensagemErro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["MensagemErro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- FORMULÁRIO DE DEPÓSITO -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4 h-100">
                <h5 class="fw-bold text-dark mb-3">Efectuar Depósito</h5>
                <form asp-action="EfetuarDeposito" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Descrição</label>
                        <input type="text" asp-for="NovoDeposito.Descricao" class="form-control rounded-2 shadow-sm" placeholder="Descrição" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Conta a Depositar</label>
                        <select asp-for="NovoDeposito.ContaDestinoId" class="form-select rounded-2 shadow-sm" required>
                            <option value="">Selecione a conta...</option>
                            @if (Model.ListaContas != null)
                            {
                                foreach (var c in Model.ListaContas)
                                {
                                    <option value="@c.Id">@c.Banco - @c.Conta - @c.Titular</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-semibold text-secondary">Valor (MT)</label>
                        <div class="input-group shadow-sm rounded-2 overflow-hidden">
                            <span class="input-group-text bg-light text-secondary fw-semibold">MT</span>
                            <input type="number" step="0.01" asp-for="NovoDeposito.Credito" class="form-control" placeholder="0,00" required />
                        </div>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-success px-4 rounded-2 text-white" style="background-color: #079b62; border-color: #079b62;">
                            <i class="fa-solid fa-check me-1"></i> Confirmar Depósito
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- FORMULÁRIO DE TRANSFERÊNCIA -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4 h-100">
                <h5 class="fw-bold text-dark mb-3">Efectuar Transferência</h5>
                <form asp-action="EfetuarTransferencia" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Descrição</label>
                        <input type="text" asp-for="NovaTransferencia.Descricao" class="form-control rounded-2 shadow-sm" placeholder="Descrição" required />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-semibold text-secondary">Valor (MT)</label>
                            <input type="number" step="0.01" asp-for="NovaTransferencia.Credito" class="form-control rounded-2 shadow-sm" placeholder="0,00" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-semibold text-secondary">Conta Origem</label>
                            <select asp-for="NovaTransferencia.ContaOrigemId" id="contaOrigemSelect" class="form-select rounded-2 shadow-sm" required>
                                <option value="">Origem...</option>
                                @if (Model.ListaContas != null)
                                {
                                    foreach (var c in Model.ListaContas)
                                    {
                                        // Filtra apenas contas com saldo superior a 0 para aparecerem na origem
                                        if (c.Saldo > 0)
                                        {
                                            <option value="@c.Id">@c.Banco - @c.Conta (Saldo: @c.Saldo.ToString("N2"))</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-semibold text-secondary">Conta Destino</label>
                        <select asp-for="NovaTransferencia.ContaDestinoId" id="contaDestinoSelect" class="form-select rounded-2 shadow-sm" required>
                            <option value="">Destino...</option>
                            @if (Model.ListaContas != null)
                            {
                                foreach (var c in Model.ListaContas)
                                {
                                    <option value="@c.Id">@c.Banco - @c.Conta - @c.Titular</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-primary px-4 rounded-2 text-white" style="background-color: #0d6efd; border-color: #0d6efd;">
                            <i class="fa-solid fa-arrow-right-arrow-left me-1"></i> Confirmar Transferência
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- TABELA DE CONTAS E SALDOS -->
    <div class="card shadow-sm border-0 rounded-4 bg-white p-4 mt-4">
        <h5 class="fw-bold text-dark mb-3">Tabela de Contas e Saldos</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small">
                    <tr>
                        <th>Banco</th>
                        <th>Número da Conta</th>
                        <th>Titular</th>
                        <th class="text-end">Saldo Atual (MT)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ListaContas != null && Model.ListaContas.Any())
                    {
                        foreach (var c in Model.ListaContas)
                        {
                            <tr>
                                <td class="fw-semibold text-dark">@c.Banco</td>
                                <td>@c.Conta</td>
                                <td>@c.Titular</td>
                                <td class="text-end fw-bold text-success">MT @c.Saldo.ToString("N2")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-3 text-muted">Nenhuma conta registada.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- TABELA DE MOVIMENTOS RECENTES -->
    <div class="card shadow-sm border-0 rounded-4 bg-white p-4 mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0">Tabela de Movimentos Recentes</h5>
            <button onclick="window.print()" class="btn btn-outline-secondary btn-sm rounded-2 px-3">
                <i class="fa-solid fa-file-pdf me-1"></i> Print/PDF
            </button>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small">
                    <tr>
                        <th>Data</th>
                        <th>Tipo</th>
                        <th>Descrição</th>
                        <th>Valor (MT)</th>
                        <th>Conta Origem</th>
                        <th>Conta Destino</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ListaMovimentos != null && Model.ListaMovimentos.Any())
                    {
                        foreach (var m in Model.ListaMovimentos)
                        {
                            bool isCredito = m.Credito > 0;
                            decimal valorExibido = isCredito ? m.Credito : m.Debito;

                            <tr>
                                <td>@m.DataCadastro.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="badge bg-light text-dark border">@m.TipoOperacao</span></td>
                                <td>@m.Descricao</td>
                                <td class="fw-bold @(isCredito ? "text-success" : "text-danger")">
                                    @(isCredito ? "+ MT " : "- MT ")@valorExibido.ToString("N2")
                                </td>
                                <td>@(m.ContaOrigem?.Banco ?? "-") - @(m.ContaOrigem?.Conta ?? "")</td>
                                <td>@(m.ContaDestino?.Banco ?? "-") - @(m.ContaDestino?.Conta ?? "")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-3 text-muted">Nenhum movimento registado recentemente.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Script JavaScript para gerir a seleção dinâmica entre Origem e Destino -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const origemSelect = document.getElementById("contaOrigemSelect");
        const destinoSelect = document.getElementById("contaDestinoSelect");

        if (origemSelect && destinoSelect) {
            origemSelect.addEventListener("change", function () {
                const selectedOrigemId = this.value;

                // Restaura a visibilidade de todas as opções no destino
                Array.from(destinoSelect.options).forEach(option => {
                    option.style.display = "block";
                });

                // Se uma origem válida foi selecionada, oculta essa mesma opção no destino
                if (selectedOrigemId) {
                    const optionToHide = destinoSelect.querySelector(`option[value="${selectedOrigemId}"]`);
                    if (optionToHide) {
                        optionToHide.style.display = "none";
                    }

                    // Se a conta de destino atual for igual à nova origem selecionada, limpa o destino
                    if (destinoSelect.value === selectedOrigemId) {
                        destinoSelect.value = "";
                    }
                }
            });
        }
    });
</script>