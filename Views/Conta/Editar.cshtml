@model Analise.Models.ContaModel
@{
    ViewData["Title"] = "Editar Conta Bancária";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true">

<div class="text-center">
    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success" role="alert">
            <button type="button" class="btn btn-danger btn-sm close-alert" aria-label="Close">X</button>
            @TempData["MensagemSucesso"]
        </div>
    }

    @if (TempData["MensagemErro"] != null)
    {
        <div class="alert alert-danger" role="alert">
            <button type="button" class="btn btn-danger btn-sm close-alert" aria-label="Close">X</button>
            @TempData["MensagemErro"]
        </div>
    }
</div>

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Editar Conta Bancária</h2>
            <p class="text-muted small mb-0">Atualize os dados da conta institucional no sistema.</p>
        </div>
        <a asp-action="Ver" class="btn btn-outline-secondary rounded-2 px-3 d-flex align-items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i> Voltar à Lista
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 bg-white">
        <div class="card-body p-4">
            <form asp-action="Editar" method="post" id="formEditarConta">
                @Html.AntiForgeryToken()

                <!-- Campo oculto para enviar o ID da conta -->
                <input type="hidden" name="id" value="@Model?.Id" />

                <div class="row g-3">
                    <!-- Banco -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary">Banco</label>
                        <input type="text" name="banco" value="@Model?.Banco" class="form-control rounded-2 shadow-sm" placeholder="Ex: Standard Bank, BCI, Moza..." required />
                    </div>

                    <!-- Número da Conta -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary">Número da Conta</label>
                        <input type="text" name="conta" value="@Model?.Conta" class="form-control rounded-2 shadow-sm" placeholder="Ex: 3322020000" required />
                    </div>

                    <!-- NIB -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary">NIB</label>
                        <input type="text" name="nib" value="@Model?.NIB" class="form-control rounded-2 shadow-sm" placeholder="Ex: 0120 0000 0000 0000" required />
                    </div>

                    <!-- Titular -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary">Titular da Conta</label>
                        <input type="text" name="titular" value="@Model?.Titular" class="form-control rounded-2 shadow-sm" placeholder="Ex: Nael Microcrédito E.I." required />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Ver" class="btn btn-light px-4 rounded-2 text-secondary border">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-4 rounded-2 text-white fw-normal" style="background-color: #0d6efd; border-color: #0d6efd;">
                        <i class="fa-solid fa-check me-1"></i> Guardar Alterações
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>