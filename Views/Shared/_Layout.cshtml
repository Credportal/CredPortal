@using Microsoft.EntityFrameworkCore
@inject Analise.Helper.ISessao SessaoUsuario
@inject Analise.Data.BancoContext _context

<!DOCTYPE html>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    
    // Obter os dados do utilizador autenticado
    var usuario = SessaoUsuario.BuscarSessaoDoUsuario();

    string nomeUtilizador = usuario?.Login ?? "Administrador";

    string primeiraLetra = !string.IsNullOrEmpty(nomeUtilizador)
        ? nomeUtilizador.Substring(0, 1).ToUpper()
        : "A";

    // Obter o ID da agência associado ao utilizador
    var agenciaId = usuario?.AgenciaId;

    // Nome apresentado no menu lateral
    string agenciaUtilizador = "Agência não identificada";

    if (agenciaId != null)
    {
        var agencia = await _context.Agencias
            .AsNoTracking()
            .FirstOrDefaultAsync(a => a.Id == agenciaId);

        agenciaUtilizador = agencia?.Nome ?? "Agência não identificada";
    }
}
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cred</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            :root {
                --sg-green: #079b62;
                --sg-green-dark: #08784f;
                --sg-bg: #f5f7fb;
                --sg-text: #172b4d;
                --sg-muted: #718096;
                --sg-border: #e8edf3;
            }

            body {
                background-color: var(--sg-bg);
                color: var(--sg-text);
                font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
                margin: 0;
                padding: 0;
            }

            /* SIDEBAR FIXA COM TRANSIÇÃO */
            .sg-sidebar {
                width: 245px;
                min-height: 100vh;
                background: #fff;
                border-right: 1px solid var(--sg-border);
                padding: 24px 18px;
                position: fixed;
                left: 0;
                top: 70px;
                bottom: 0;
                overflow-y: auto;
                z-index: 1030;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                transition: transform 0.3s ease;
            }

            /* ESTADO RECOLHIDO DA SIDEBAR */
            body.sidebar-collapsed .sg-sidebar {
                transform: translateX(-100%);
            }

            .sg-brand {
                display: flex;
                align-items: center;
                gap: 10px;
                font-size: 23px;
                font-weight: 800;
                color: var(--sg-green);
                text-decoration: none;
            }

                .sg-brand i {
                    font-size: 29px;
                }

            .sg-nav-link {
                display: flex;
                align-items: center;
                gap: 13px;
                padding: 13px 14px;
                border-radius: 9px;
                text-decoration: none;
                color: #24415f;
                font-weight: 600;
                transition: .2s;
                font-size: 14px;
                white-space: nowrap;
            }

                .sg-nav-link i {
                    width: 21px;
                    text-align: center;
                    font-size: 17px;
                }

                .sg-nav-link:hover,
                .sg-nav-link.active {
                    color: #fff !important;
                    background: var(--sg-green) !important;
                }

            /* TOPBAR FIXA */
            .sg-topbar {
                min-height: 68px;
                padding: 14px 27px;
                background: #fff;
                border-bottom: 1px solid var(--sg-border);
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 15px;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 70px;
                z-index: 1040;
            }

            /* CONTAINER PRINCIPAL COM TRANSIÇÃO DE MARGEM */
            .sg-main-wrapper {
                margin-left: 245px;
                margin-top: 70px;
                padding: 27px;
                min-height: calc(100vh - 70px);
                transition: margin-left 0.3s ease;
            }

            /* EXPANDIR CONTEÚDO QUANDO A SIDEBAR ESTIVER FECHADA */
            body.sidebar-collapsed .sg-main-wrapper {
                margin-left: 0;
            }

            /* LOADER */
            .loader-backdrop {
                position: fixed;
                top: 0;
                left: 0;
                width: 100vw;
                height: 100vh;
                background: rgba(255,255,255,0.7);
                z-index: 9998;
            }

            .loader-box {
                position: fixed;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                z-index: 9999;
                text-align: center;
            }

            .spinner {
                width: 40px;
                height: 40px;
                border: 4px solid #f3f3f3;
                border-top: 4px solid var(--sg-green);
                border-radius: 50%;
                animation: spin 1s linear infinite;
                margin: 0 auto 10px;
            }

            @@keyframes spin {
                0% {
                    transform: rotate(0deg);
                }

                100% {
                    transform: rotate(360deg);
                }
            }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body class="sidebar-collapsed">

    <div id="global-loader" style="display:none;">
        <div class="loader-backdrop"></div>
        <div class="loader-box">
            <div class="spinner"></div>
            <div class="fw-semibold text-secondary">A processar...</div>
        </div>
    </div>

    <!-- TOPO SUPERIOR -->
    <header class="sg-topbar">
        <div class="d-flex align-items-center gap-3">
            <!-- BOTÃO PARA ESCONDER / MOSTRAR A BARRA LATERAL -->
            <button class="btn btn-light rounded-circle p-2 border-0 shadow-sm" type="button" id="sidebarToggle" title="Alternar Menu Lateral" style="width: 38px; height: 38px;">
                <i class="fa-solid fa-bars text-secondary"></i>
            </button>

            <!-- LOGO CRED QUE MOSTRA A SIDEBAR E VOLTA AO PAINEL -->
            <a asp-controller="Home" asp-action="Index" class="sg-brand" id="logoBrand">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Cred</span>
            </a>
        </div>

        <div class="d-flex align-items-center gap-3">
           @*  <div class="d-none d-md-block" style="width: 260px;">
                <input type="search" id="sgSearch"
                       class="form-control form-control-sm rounded-pill px-3"
                       placeholder="Pesquisar cliente ou apólice...">
            </div> *@
            <div class="dropdown">
                <button class="btn btn-light position-relative rounded-circle p-2" type="button" id="dropdownNotificacoes" data-bs-toggle="dropdown" aria-expanded="false" title="Notificações">
                    <i class="fa-regular fa-bell"></i>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success" style="font-size: 8px;">
                        @(ViewBag.TotalNotificacoesHoje ?? 0)
                    </span>
                </button>

                <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2" aria-labelledby="dropdownNotificacoes" style="width: 320px; max-height: 400px; overflow-y: auto;">
                    <li class="px-3 py-2 border-bottom d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark small">Prestações a Vencer Hoje</span>
                        <span class="badge bg-success rounded-pill">@(ViewBag.TotalNotificacoesHoje ?? 0)</span>
                    </li>

                    @{
                        var notificacoes = ViewBag.PrestacoesHoje as List<Analise.Models.AmortizacaoModel>;
                    }

                    @if (notificacoes != null && notificacoes.Any())
                    {
                        foreach (var item in notificacoes)
                        {
                            <li>
                                <a class="dropdown-item py-2 text-wrap small border-bottom" asp-controller="Pedido" asp-action="Pagamento" asp-route-id="@item.PedidoId">
                                    <div class="fw-bold text-dark">
                                        <i class="fa-solid fa-triangle-exclamation text-warning me-1"></i>
                                        @(item.Pedido?.Entidade?.Nome ?? "Cliente")
                                    </div>
                                    <div class="text-muted" style="font-size: 11px;">
                                        Prestação #@item.NR | Valor: <strong>MT @((item.PrincipalPorPagar + item.JuroPorPagar).ToString("N2"))</strong>
                                    </div>
                                </a>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="text-center py-3 text-muted small">
                            Nenhuma prestação vence hoje.
                        </li>
                    }
                </ul>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 13px;">
                    @primeiraLetra
                </div>
                <span class="small fw-semibold d-none d-md-inline text-dark">@nomeUtilizador</span>
                <i class="fa-solid fa-chevron-down small text-muted"></i>
            </div>
        </div>
    </header>

    <!-- MENU LATERAL -->
    <aside class="sg-sidebar">
        <div>
            <nav class="d-flex flex-column gap-1">
                <a asp-controller="Home" asp-action="Index" class="sg-nav-link @(currentController == "Painel" || currentController == "Home" ? "active" : "")">
                    <i class="fa-solid fa-house fa-fw"></i> Painel
                </a>
                <a asp-controller="Conta" asp-action="Ver" class="sg-nav-link @(currentController == "Conta" ? "active" : "")">
                    <i class="fa-solid fa-chart-line fa-fw"></i> Contas
                </a>
                <a asp-controller="Entidade" asp-action="Ver" class="sg-nav-link @(currentController == "Entidade" ? "active" : "")">
                    <i class="fa-solid fa-user fa-fw"></i> Entidades
                </a>
                <a asp-controller="Simulador" asp-action="Index" class="sg-nav-link @(currentController == "Simulador" ? "active" : "")">
                    <i class="fa-solid fa-calculator fa-fw"></i> Simulador
                </a>
                <a asp-controller="Pedido" asp-action="Ver" class="sg-nav-link @(currentController == "Pedido" ? "active" : "")">
                    <i class="fa-solid fa-credit-card fa-fw"></i> Créditos
                </a>
                <a asp-controller="Relatorio" asp-action="Index" class="sg-nav-link @(currentController == "Relatorio" ? "active" : "")">
                    <i class="fa-solid fa-chart-pie fa-fw"></i> Relatórios
                </a>
                <a asp-controller="Configuracao" asp-action="Index" class="sg-nav-link @(currentController == "Configuracao" ? "active" : "")">
                    <i class="fa-solid fa-gear fa-fw"></i> Configurações
                </a>

                <a asp-controller="Usuario" asp-action="Criar" class="sg-nav-link @(currentController == "Criar" ? "active" : "")">
                    <i class="fa-solid fa-users fa-fw"></i> Usuários
                </a>
                <a asp-controller="AlterarSenha" asp-action="Index" class="sg-nav-link @(currentController == "Index" ? "active" : "")">
                    <i class="fa-solid fa-key fa-fw"></i> Alterar Senha
                </a>
            </nav>
        </div>

        <div>
            <div class="p-3 rounded-3 mb-3" style="background: #f0faf5; border: 1px solid #e1f1e9;">
                <i class="fa-solid fa-shield-halved text-success fs-3 mb-2"></i>
                <div class="fw-bold text-dark small">Cred</div>
                <div class="text-secondary" style="font-size: 11px;">Sua gestão simplificada.</div>
            </div>

            <div class="p-2 border rounded-3 bg-white d-flex align-items-center justify-content-between text-secondary small mb-3">
                <span><i class="fa-solid fa-location-dot me-2 text-secondary"></i> @agenciaUtilizador</span>
                <i class="fa-solid fa-chevron-down"></i>
            </div>

            <div class="text-muted" style="font-size: 10px;">
                &copy; @DateTime.Now.Year Cred, Lda.<br>Todos os direitos reservados.
            </div>
        </div>
    </aside>

    <!-- CONTEÚDO PRINCIPAL -->
    <main class="sg-main-wrapper">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
            function mostrarLoader() { document.getElementById("global-loader").style.display = "block"; }
            function esconderLoader() { document.getElementById("global-loader").style.display = "none"; }

            document.addEventListener("DOMContentLoaded", function () {
                const sidebarToggle = document.getElementById("sidebarToggle");
                const logoBrand = document.getElementById("logoBrand");
                const body = document.body;

                // Verifica o estado guardado no localStorage ao iniciar
                const savedState = localStorage.getItem("sidebarState");
                if (savedState === "expanded") {
                    body.classList.remove("sidebar-collapsed");
                } else if (savedState === "collapsed") {
                    body.classList.add("sidebar-collapsed");
                }

                // Alternar sidebar com o botão de hambúrguer
                if (sidebarToggle) {
                    sidebarToggle.addEventListener("click", function () {
                        body.classList.toggle("sidebar-collapsed");
                        if (body.classList.contains("sidebar-collapsed")) {
                            localStorage.setItem("sidebarState", "collapsed");
                        } else {
                            localStorage.setItem("sidebarState", "expanded");
                        }
                    });
                }

                // Ao clicar no logo Cred, força a abertura da sidebar e define o estado como expandido
                if (logoBrand) {
                    logoBrand.addEventListener("click", function () {
                        body.classList.remove("sidebar-collapsed");
                        localStorage.setItem("sidebarState", "expanded");
                    });
                }

                document.querySelectorAll("form").forEach(f => f.addEventListener("submit", mostrarLoader));
                document.querySelectorAll("a").forEach(l => l.addEventListener("click", function () {
                    if (l.getAttribute("target") === "_blank" || l.getAttribute("href")?.startsWith("#")) return;
                    mostrarLoader();
                }));
                window.addEventListener("focus", esconderLoader);
            });
    </script>
</body>
</html>