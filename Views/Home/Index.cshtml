@{
    ViewData["Title"] = "Painel de Controlo";
    Layout = "_Layout";

}

<style>
    .sg-card {
        background: #fff;
        border: 1px solid #e8edf3;
        border-radius: 12px;
        padding: 20px;
        height: 100%;
        box-shadow: 0 2px 6px rgba(0,0,0,0.02);
    }

    .sg-kpi-icon-wrapper {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #e7f7ef;
        color: #079b62;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

        .sg-kpi-icon-wrapper.orange {
            background: #fff3e4;
            color: #ed900c;
        }

    .sg-filter-select {
        background: #fff;
        border: 1px solid #e8edf3;
        border-radius: 8px;
        padding: 6px 12px;
        font-size: 13px;
        color: #4a5568;
        outline: none;
    }

    .sg-badge-status {
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
    }

        .sg-badge-status.renovar {
            background: #fff3e4;
            color: #ed900c;
        }

        .sg-badge-status.pendente {
            background: #fee2e2;
            color: #dc2626;
        }

    .sg-badge-dias {
        background: #fee2e2;
        color: #dc2626;
        padding: 2px 8px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 12px;
    }

    .sg-partner-box {
        border: 1px solid #e8edf3;
        border-radius: 10px;
        padding: 14px;
        text-align: center;
        font-weight: 700;
        background: #fff;
        font-size: 13px;
    }
</style>

<!-- TÍTULO E FILTROS SUPERIORES -->
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1 fs-3">Painel de Controlo</h2>
        <div class="text-secondary small">Visão geral do desempenho da carteira de crédito</div>
    </div>
</div>

<!-- CARDS KPI SUPERIORES -->
<div class="row g-3 mb-4 row-cols-1 row-cols-md-2 row-cols-xl-3 row-cols-xxl-6">
    <div class="col">
        <div class="sg-card d-flex align-items-center gap-3 bg-white p-3 shadow-sm rounded-4 border-0 h-100">
            <div class="sg-kpi-icon-wrapper text-success fs-3"><i class="fa-solid fa-cart-shopping"></i></div>
            <div>
                <div class="text-secondary small">Desembolso do mês <i class="fa-regular fa-circle-question ms-1"></i></div>
                <div class="fw-bold fs-5 text-dark">
                    MT @(((decimal)(ViewBag.TotalDesembolsosMes ?? 0)).ToString("N2"))
                </div>
                @{
                    decimal variacao = ViewBag.VariacaoDesembolsos ?? 0;
                    string classeCor = variacao >= 0 ? "text-success" : "text-danger";
                    string iconeSeta = variacao >= 0 ? "fa-arrow-up" : "fa-arrow-down";
                    string sinal = variacao >= 0 ? "+" : "";
                }
                <div class="@classeCor small fw-semibold" style="font-size: 11px;">
                    <i class="fa-solid @iconeSeta me-1"></i>@sinal@variacao.ToString("N1")% <span class="text-muted fw-normal">vs. mês anterior</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Pagamentos Previstos do Mês -->
    <div class="col">
        <div class="sg-card d-flex align-items-center gap-3 bg-white p-3 shadow-sm rounded-4 border-0 h-100">
            <div class="sg-kpi-icon-wrapper text-primary fs-3"><i class="fa-solid fa-file-circle-check"></i></div>
            <div>
                <div class="text-secondary small">Pagamentos Previstos do Mês <i class="fa-regular fa-circle-question ms-1"></i></div>
                <div class="fw-bold fs-5 text-dark">
                    MT @(((decimal)(ViewBag.PagamentosPrevistosMes ?? 0)).ToString("N2"))
                </div>
                @{
                    decimal varPrevistos = ViewBag.VariacaoPrevistos ?? 0;
                    string corPrev = varPrevistos >= 0 ? "text-success" : "text-danger";
                    string iconePrev = varPrevistos >= 0 ? "fa-arrow-up" : "fa-arrow-down";
                    string sinalPrev = varPrevistos >= 0 ? "+" : "";
                }
                <div class="@corPrev small fw-semibold" style="font-size: 11px;">
                    <i class="fa-solid @iconePrev me-1"></i>@sinalPrev@varPrevistos.ToString("N1")% <span class="text-muted fw-normal">vs. mês anterior</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Pagamentos Pendentes do Mês -->
    <div class="col">
        <div class="sg-card d-flex align-items-center gap-3 bg-white p-3 shadow-sm rounded-4 border-0 h-100">
            <div class="sg-kpi-icon-wrapper text-warning fs-3"><i class="fa-solid fa-coins"></i></div>
            <div>
                <div class="text-secondary small">Pagamentos Pendentes do Mês <i class="fa-regular fa-circle-question ms-1"></i></div>
                <div class="fw-bold fs-5 text-dark">
                    MT @(((decimal)(ViewBag.PagamentosPendentesMes ?? 0)).ToString("N2"))
                </div>
                @{
                    decimal varPendentes = ViewBag.VariacaoPendentes ?? 0;
                    string corPend = varPendentes >= 0 ? "text-success" : "text-danger";
                    string iconePend = varPendentes >= 0 ? "fa-arrow-up" : "fa-arrow-down";
                    string sinalPend = varPendentes >= 0 ? "+" : "";
                }
                <div class="@corPend small fw-semibold" style="font-size: 11px;">
                    <i class="fa-solid @iconePend me-1"></i>@sinalPend@varPendentes.ToString("N1")% <span class="text-muted fw-normal">vs. mês anterior</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Carteira Vigente -->
    <div class="col">
        <div class="sg-card d-flex align-items-center gap-3 bg-white p-3 shadow-sm rounded-4 border-0 h-100">
            <div class="sg-kpi-icon-wrapper text-success fs-3"><i class="fa-solid fa-shield-halved"></i></div>
            <div>
                <div class="text-secondary small">Carteira Vigente <i class="fa-regular fa-circle-question ms-1"></i></div>
                <div class="fw-bold fs-5 text-dark">
                    MT @(((decimal)(ViewBag.CarteiraVigente ?? 0)).ToString("N2"))
                </div>
                @{
                    decimal varCarteira = ViewBag.VariacaoCarteiraVigente ?? 0;
                    string corCart = varCarteira >= 0 ? "text-success" : "text-danger";
                    string iconeCart = varCarteira >= 0 ? "fa-arrow-up" : "fa-arrow-down";
                    string sinalCart = varCarteira >= 0 ? "+" : "";
                }
                <div class="@corCart small fw-semibold" style="font-size: 11px;">
                    <i class="fa-solid @iconeCart me-1"></i>@sinalCart@varCarteira.ToString("N1")% <span class="text-muted fw-normal">vs. mês anterior</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Clientes (Total e Ativos) -->
    <div class="col">
        <div class="sg-card d-flex align-items-center gap-3 bg-white p-3 shadow-sm rounded-4 border-0 h-100">
            <div class="sg-kpi-icon-wrapper text-info fs-3"><i class="fa-solid fa-users"></i></div>
            <div>
                <div class="text-secondary small">Clientes <i class="fa-regular fa-circle-question ms-1"></i></div>
                <div class="fw-bold fs-5 text-dark">
                    <span class="text-dark">@(ViewBag.ClientesTotaisCount ?? 0)</span>
                    <span class="text-muted fw-normal fs-6">/</span>
                    <span class="text-success">@(ViewBag.ClientesVigentesCount ?? 0)</span>
                </div>
                <div class="text-muted small" style="font-size: 11px;">
                    <span>Geral / Ativos</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Carteira em Mora -->
    <div class="col">
        <div class="sg-card d-flex align-items-center gap-3 bg-white p-3 shadow-sm rounded-4 border-0 h-100">
            <div class="sg-kpi-icon-wrapper text-danger fs-3"><i class="fa-solid fa-wallet"></i></div>
            <div>
                <div class="text-secondary small">Carteira em Mora <i class="fa-regular fa-circle-question ms-1"></i></div>
                <div class="fw-bold fs-5 text-dark">
                    MT @(((decimal)(ViewBag.CarteiraEmMora ?? 0)).ToString("N2"))
                </div>
                <div class="text-secondary small" style="font-size: 11px;">
                    <span class="fw-bold text-dark">@(ViewBag.QuantidadeCobrancasMora ?? 0)</span> cobranças pendentes
                </div>
            </div>
        </div>
    </div>
</div>

<!-- GRÁFICOS PRINCIPAIS -->
<div class="row g-3 mb-4">
    <div class="col-12 col-xl-7">
        <div class="sg-card bg-white p-4 shadow-sm rounded-4 border-0">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark m-0">Evolução da Carteira Vigente</h6>
                <div class="d-flex gap-2 align-items-center">
                    <select class="form-select form-select-sm sg-filter-select"><option>MT</option></select>
                    <i class="fa-solid fa-ellipsis-vertical text-muted"></i>
                </div>
            </div>
            <div style="height: 260px;"><canvas id="sgVendasChart"></canvas></div>
        </div>
    </div>

    <div class="col-12 col-xl-5">
        <div class="sg-card bg-white p-4 shadow-sm rounded-4 border-0">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark m-0">Operações Chave</h6>
                <i class="fa-solid fa-ellipsis-vertical text-muted"></i>
            </div>
            <div style="height: 260px;"><canvas id="sgRamosChart"></canvas></div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- Vencimentos próximos -->
    <div class="col-12 col-xl-6">
        <div class="sg-card p-0">
            <div class="p-3 d-flex justify-content-between align-items-center border-bottom">
                <h6 class="fw-bold text-dark m-0"><i class="fa-regular fa-calendar me-2 text-success"></i>Vencimentos próximos</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0" style="font-size: 13px;">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="ps-3 border-0">Cliente</th>
                            <th class="border-0">Valor por pagar</th>
                            <th class="border-0">Vencimento</th>
                            <th class="border-0 text-center">Atraso</th>
                            <th class="border-0">Contacto</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var vencimentosProximosList = ViewBag.VencimentosProximos as List<Analise.Models.AmortizacaoModel>;
                        }
                        @if (vencimentosProximosList != null && vencimentosProximosList.Any())
                        {
                            foreach (var item in vencimentosProximosList)
                            {
                                // CORREÇÃO AQUI: Invertido para mostrar os dias restantes em negativo (ex: -30 dias)
                                int diasRestantes = (item.Vencimento.Date - DateTime.Today).Days;
                                decimal valorTotal = item.PrincipalPorPagar + item.JuroPorPagar + item.MultaPorPagar;
                                <tr>
                                    <td class="ps-3 fw-semibold text-dark">
                                        <i class="fa-solid fa-user text-success me-2"></i>@(item.Pedido?.Entidade?.Nome ?? "N/D")
                                    </td>
                                    <td class="fw-semibold">MT @valorTotal.ToString("N2")</td>
                                    <td>@item.Vencimento.ToString("dd MMM yyyy")</td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary-subtle text-secondary px-2 py-1">
                                            -@diasRestantes dias
                                        </span>
                                    </td>
                                    <td>@(item.Pedido?.Entidade?.Telefone ?? "N/D")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">Sem vencimentos próximos registados.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="p-2 text-center border-top">
                <a asp-controller="Conta" asp-action="Ver" class="text-success text-decoration-none fw-bold small">Ver todas <i class="fa-solid fa-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>

    <!-- Pagamentos pendentes -->
    <div class="col-12 col-xl-6">
        <div class="sg-card p-0">
            <div class="p-3 d-flex justify-content-between align-items-center border-bottom">
                <h6 class="fw-bold text-dark m-0"><i class="fa-regular fa-credit-card me-2 text-success"></i>Pagamentos pendentes</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0" style="font-size: 13px;">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="ps-3 border-0">Cliente</th>
                            <th class="border-0">Valor por pagar</th>
                            <th class="border-0">Vencimento</th>
                            <th class="border-0 text-center">Atraso</th>
                            <th class="border-0">Contacto</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var pagamentosPendentesList = ViewBag.PagamentosPendentes as List<Analise.Models.AmortizacaoModel>;
                        }
                        @if (pagamentosPendentesList != null && pagamentosPendentesList.Any())
                        {
                            foreach (var item in pagamentosPendentesList)
                            {
                                int diasAtraso = (DateTime.Today - item.Vencimento.Date).Days;
                                decimal valorTotal = item.PrincipalPorPagar + item.JuroPorPagar + item.MultaPorPagar;
                                <tr>
                                    <td class="ps-3 fw-semibold text-dark">
                                        <i class="fa-solid fa-user text-danger me-2"></i>@(item.Pedido?.Entidade?.Nome ?? "N/D")
                                    </td>
                                    <td class="fw-semibold">MT @valorTotal.ToString("N2")</td>
                                    <td>@item.Vencimento.ToString("dd MMM yyyy")</td>
                                    <td class="text-center">
                                        <span class="badge bg-danger-subtle text-danger px-2 py-1 fw-bold">
                                            +@diasAtraso dias
                                        </span>
                                    </td>
                                    <td>@(item.Pedido?.Entidade?.Telefone ?? "N/D")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">Nenhum pagamento pendente em atraso.</td></tr>
                        }
                    </tbody>
                </table>
            </div>           
        </div>
    </div>
</div>

<!-- CANAIS E LINHAS DE CRÉDITO -->
<div class="row g-3">
    <div class="col-12 col-lg-6">
        <div class="sg-card bg-white p-4 shadow-sm rounded-4 border-0 h-100">
            <h6 class="fw-bold text-dark mb-3">Meios de pagamento</h6>
            <div class="d-flex flex-wrap gap-2 align-items-center">

                <!-- M-Pesa -->
                <div class="sg-partner-box px-3 py-2 border rounded-3 bg-white d-flex align-items-center gap-2 shadow-sm">
                    <span class="badge bg-danger rounded-circle p-1" style="width: 8px; height: 8px;"></span>
                    <span class="fw-bold text-danger" style="font-size: 13px;">M-Pesa</span>
                </div>

                <!-- E-Mola -->
                <div class="sg-partner-box px-3 py-2 border rounded-3 bg-white d-flex align-items-center gap-2 shadow-sm">
                    <span class="badge rounded-circle p-1" style="width: 8px; height: 8px; background-color: #ff6600;"></span>
                    <span class="fw-bold" style="color: #ff6600; font-size: 13px;">E-Mola</span>
                </div>

                <!-- BCI -->
                <div class="sg-partner-box px-3 py-2 border rounded-3 bg-white d-flex align-items-center gap-2 shadow-sm">
                    <span class="badge rounded-circle p-1" style="width: 8px; height: 8px; background-color: #ff7700;"></span>
                    <span class="fw-bold" style="color: #ff7700; font-size: 13px;">BCI</span>
                </div>

                <!-- Millennium bim -->
                <div class="sg-partner-box px-3 py-2 border rounded-3 bg-white d-flex align-items-center gap-2 shadow-sm">
                    <span class="badge rounded-circle p-1" style="width: 8px; height: 8px; background-color: #8b0000;"></span>
                    <span class="fw-bold" style="color: #8b0000; font-size: 12px;">Millennium</span>
                </div>

                <!-- Standard Bank -->
                <div class="sg-partner-box px-3 py-2 border rounded-3 bg-white d-flex align-items-center gap-2 shadow-sm">
                    <span class="badge rounded-circle p-1" style="width: 8px; height: 8px; background-color: #002D62;"></span>
                    <span class="fw-bold" style="color: #002D62; font-size: 12px;">Standard Bank</span>
                </div>

                <!-- Absa -->
                <div class="sg-partner-box px-3 py-2 border rounded-3 bg-white d-flex align-items-center gap-2 shadow-sm">
                    <span class="badge bg-danger rounded-circle p-1" style="width: 8px; height: 8px;"></span>
                    <span class="fw-bold text-danger" style="font-size: 13px;">Absa</span>
                </div>

                <!-- Caixa -->
                <div class="sg-partner-box px-3 py-2 border rounded-3 bg-white d-flex align-items-center gap-2 shadow-sm">
                    <span class="badge rounded-circle p-1" style="width: 8px; height: 8px; background-color: #004c99;"></span>
                    <span class="fw-bold" style="color: #004c99; font-size: 12px;">Caixa</span>
                </div>

            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="sg-card bg-white p-4 shadow-sm rounded-4 border-0 h-100">
            <h6 class="fw-bold text-dark mb-3">Linhas de Crédito</h6>
            <div class="row g-2">
                <!-- Micro -->
                <div class="col">
                    <div class="sg-partner-box d-flex align-items-center justify-content-center gap-2 py-2 px-2 border rounded-3 bg-light" style="font-size: 13px;">
                        <i class="fa-solid fa-store text-success"></i> <span class="fw-semibold text-dark">Micro</span>
                    </div>
                </div>

                <!-- Consumo -->
                <div class="col">
                    <div class="sg-partner-box d-flex align-items-center justify-content-center gap-2 py-2 px-2 border rounded-3 bg-light" style="font-size: 13px;">
                        <i class="fa-solid fa-wallet text-warning"></i> <span class="fw-semibold text-dark">Consumo</span>
                    </div>
                </div>

                <!-- Habitação -->
                <div class="col">
                    <div class="sg-partner-box d-flex align-items-center justify-content-center gap-2 py-2 px-2 border rounded-3 bg-light" style="font-size: 13px;">
                        <i class="fa-solid fa-house text-primary"></i> <span class="fw-semibold text-dark">Habitação</span>
                    </div>
                </div>

                <!-- PME -->
                <div class="col">
                    <div class="sg-partner-box d-flex align-items-center justify-content-center gap-2 py-2 px-2 border rounded-3 bg-light" style="font-size: 13px;">
                        <i class="fa-solid fa-briefcase text-info"></i> <span class="fw-semibold text-dark">PME</span>
                    </div>
                </div>

                <!-- Outras -->
                <div class="col">
                    <div class="sg-partner-box d-flex align-items-center justify-content-center py-2 px-2 border rounded-3 bg-light text-muted fw-semibold" style="font-size: 13px;">
                        ... Outras
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const carteiraLabels = @Html.Raw(ViewBag.CarteiraLabels ?? "[]");
        const carteiraValores = @Html.Raw(ViewBag.CarteiraValores ?? "[]");

        new Chart(document.getElementById('sgVendasChart'), {
            type: 'line',
            data: {
                labels: carteiraLabels,
                datasets: [{
                    label: 'Carteira Vigente (MT)',
                    data: carteiraValores,
                    borderColor: '#079b62',
                    backgroundColor: 'rgba(7, 155, 98, 0.08)',
                    fill: true,
                    tension: 0.4,
                    borderWidth: 2.5,
                    pointRadius: 4,
                    pointBackgroundColor: '#079b62'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: '#f1f5f9' },
                        ticks: { callback: v => (v / 1000) + 'k MT' }
                    },
                    x: { grid: { display: false } }
                }
            }
        });

        new Chart(document.getElementById('sgRamosChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(ViewBag.OperacoesChaveLabels ?? "[]"),
                datasets: [{
                    data: @Html.Raw(ViewBag.OperacoesChaveValores ?? "[]"),
                    backgroundColor: ['#079b62', '#3b82f6', '#f59e0b', '#20c997', '#ef4444'],
                    borderWidth: 2,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '70%',
                plugins: {
                    legend: {
                        position: 'right',
                        labels: { usePointStyle: true, boxWidth: 8 }
                    }
                }
            }
        });
    </script>
}