@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // Gráfico de evolução das vendas
        const vendasLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(vendas.Select(x => x.Mes)));
        const vendasValores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(vendas.Select(x => x.Valor)));

        new Chart(document.getElementById('sgVendasChart'), {
            type: 'line',
            data: {
                labels: vendasLabels,
                datasets: [{
                    label: 'Vendas (MT)',
                    data: vendasValores,
                    borderColor: '#079b62',
                    backgroundColor: 'rgba(7, 155, 98, 0.10)',
                    fill: true,
                    tension: 0.35,
                    borderWidth: 3,
                    pointRadius: 4,
                    pointBackgroundColor: '#079b62'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ': ' +
                                    new Intl.NumberFormat('pt-PT').format(context.raw) + ' MT';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: value =>
                                new Intl.NumberFormat('pt-PT', {
                                    notation: 'compact'
                                }).format(value) + ' MT'
                        },
                        grid: { color: '#edf1f5' }
                    },
                    x: { grid: { display: false } }
                }
            }
        });

        // Gráfico de distribuição por ramo
        new Chart(document.getElementById('sgRamosChart'), {
            type: 'doughnut',
            data: {
                labels: ['Automóvel', 'Saúde', 'Vida', 'Multirriscos', 'Outros'],
                datasets: [{
                    data: [48, 22, 12, 10, 8],
                    backgroundColor: [
                        '#079b62', '#4285d4', '#f5ac28',
                        '#8656cc', '#91a0b5'
                    ],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '62%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { usePointStyle: true, padding: 16 }
                    },
                    tooltip: {
                        callbacks: {
                            label: context => context.label + ': ' + context.raw + '%'
                        }
                    }
                }
            }
        });

        // Filtro demonstrativo por ramo
        document.getElementById('sgRamo').addEventListener('change', function() {
            const ramo = this.value;

            document.querySelectorAll('#sgVencimentos tbody tr').forEach(row => {
                row.style.display =
                    ramo === 'todos' || row.dataset.ramo === ramo ? '' : 'none';
            });
        });

        // Pesquisa nas tabelas de vencimentos e pagamentos
        document.getElementById('sgSearch').addEventListener('input', function() {
            const termo = this.value.toLocaleLowerCase();

            ['sgVencimentos', 'sgPagamentos'].forEach(id => {
                document.querySelectorAll('#' + id + ' tbody tr').forEach(row => {
                    row.style.display =
                        row.textContent.toLocaleLowerCase().includes(termo) ? '' : 'none';
                });
            });
        });
    </script>
}





<script>

const btnMenu = document.getElementById("btnMenuLateral");

const menu = document.getElementById("menuLateral");

let aberto=false;

btnMenu.onclick=function(){

if(!aberto){

menu.style.left="0px";

aberto=true;

}else{

menu.style.left="-260px";

aberto=false;

}

};

/* SUBMENU */

const toggles=document.querySelectorAll(".submenu-toggle");

toggles.forEach(toggle=>{

toggle.addEventListener("click",function(){

const submenu=this.nextElementSibling;

if(submenu.style.display==="block"){

submenu.style.display="none";

}else{

submenu.style.display="block";

}

});

});

</script>
