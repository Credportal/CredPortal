<style>

/* BOTÃO MENU */

#btnMenuLateral{
    position:fixed;
    top:70px;
    left:15px;
    z-index:2000;

    font-size:24px;
        
    background: linear-gradient(180deg,#111111,#000000);

    border:none;
    color:white;

    padding:8px 12px;
    border-radius:10px;

    cursor:pointer;

    box-shadow:0 6px 15px rgba(0,0,0,.3);
}

/* MENU LATERAL */

#menuLateral{

    position:fixed;
    top:40px;
    left:-260px;

    width:260px;
    height:100%;
        
    background: linear-gradient(180deg,#1a1a1a,#000000);

    backdrop-filter: blur(15px);

    border-right:1px solid rgba(255,255,255,0.05);

    transition:left .35s ease;

    z-index:1500;

    padding-top:90px;

    overflow-y:auto;
}

/* LISTA */

#menuLateral ul{
    list-style:none;
    padding:0;
    margin:0;
}

/* LINKS */

#menuLateral ul li a{

    display:flex;
    align-items:center;
    gap:10px;

    padding:12px 18px;

    color:#c8f5df;

    text-decoration:none;

    font-size:14px;

    border-radius:8px;

    transition:all .25s ease;
}

/* HOVER */

#menuLateral ul li a:hover{

    background:rgba(72,200,120,0.15);

    color:#48c878;

    transform:translateX(4px);
}

/* SUBMENU */

#menuLateral .submenu{
    display:none;
    padding-left:18px;
}

#menuLateral .submenu li a{

    font-size:13px;

    color:#9fe5c3;
}

#menuLateral .submenu li a:hover{

    background:rgba(72,200,120,0.12);
}

/* TITULO */

.titulo-dashboard{

    text-align:center;

    margin-top:30px;

    font-size:28px;

    font-weight:600;

    color:#333;
}

/* GRID MENU */

.menu-app{

    display:grid;

    grid-template-columns:repeat(3,1fr);

    gap:30px;

    max-width:900px;

    margin:40px auto;
}

/* CARD */

.menu-card{

    background:white;

    border-radius:12px;

    padding:30px;

    text-align:center;

    text-decoration:none;

    color:#333;

    box-shadow:0 8px 20px rgba(0,0,0,0.08);

    transition:0.2s;
}

.menu-card:hover{

    transform:translateY(-5px);

    box-shadow:0 12px 30px rgba(0,0,0,0.15);
}

.menu-card img{

    width:70px;

    height:70px;

    margin-bottom:15px;
}

.menu-card span{

    display:block;

    font-size:18px;

    font-weight:600;
}

    .hero {
        width: 100vw; /* largura total da viewport */
        margin-left: calc(-50vw + 50%);
        margin-top: 120px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 60px;
        padding: 80px 40px;
        background: linear-gradient(180deg, #000000, #0b0b0b);
        color: white;
        flex-wrap: wrap; /* responsivo */
        box-sizing: border-box; /* evita estouro */
    }

    .hero-left {
        flex: 1;
    }

    .hero-right {
        flex: 1;
    }

    /* Cards */
    .menu-cards {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .card-btn {
        height: 140px;
        background: rgba(255,255,255,0.05);
        border-radius: 15px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-decoration: none;
        color: white;
        transition: 0.3s;
    }

        .card-btn i {
            font-size: 35px;
            margin-bottom: 10px;
            color: #48c878;
        }

        .card-btn:hover {
            transform: translateY(-6px);
            background: rgba(72,200,120,0.15);
        }

    /* Texto */
    .hero-right h1 {
        font-size: 48px;
        margin-bottom: 20px;
    }

    .hero-right span {
        color: white;
    }

    .hero-right p {
        max-width: 500px;
        color: #9fe5c3;
    }

</style>

